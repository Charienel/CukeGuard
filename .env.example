CUKEGUARD_OWNER_PHONE=
CUKEGUARD_DATA_MODE=hardware
CUKEGUARD_MISTER_INITIAL_STATE=
CUKEGUARD_SMS_PROVIDER=sim800l
CUKEGUARD_SIM800L_PORT=/dev/serial0
CUKEGUARD_SIM800L_BAUD=9600
# Bundled cucumber growth-stage detector and scan sampling interval.
CUKEGUARD_YOLO_MODEL_PATH=models/yolov8n_cucumber.pt
CUKEGUARD_YOLO_CONFIDENCE=0.25
CUKEGUARD_SCAN_SAMPLE_MM=5
CUKEGUARD_SCAN_SETTLE_SECONDS=0.1
CUKEGUARD_MODEL_POSITIVE_LABEL=good
# CUKEGUARD_MODEL_PATH=models/cucumber_condition.keras
